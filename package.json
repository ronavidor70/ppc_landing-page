  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "marked": "^18.1.2",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}

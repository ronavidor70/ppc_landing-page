# ============================================================
#  תבנית משתני סביבה — העתק ל-.env ומלא ערכים אמיתיים.
#  ב-Vite כל משתנה חייב להתחיל ב-VITE_.
#  בפרודקשן (Render): הגדר את המשתנים האלה ב-Environment של השירות.
# ============================================================

# ---- Supabase (ה-CRM) ----
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_SUPABASE_LEADS_TABLE=leads

# ---- Webhook חלופי ל-CRM (אופציונלי) ----
VITE_CRM_WEBHOOK_URL=

# ---- כלי מחקר מילים (Edge Function) ----
# בסיס ה-Functions של Supabase. ריק = הווידג'ט עובר ל-fallback (Google Trends).
# דוגמה: https://xxxxxxxx.supabase.co/functions/v1
VITE_TOOLS_API_URL=
